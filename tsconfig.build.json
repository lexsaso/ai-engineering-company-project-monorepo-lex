{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "noEmitOnError": true,
    "rootDir": "packages/shared/types",
    "outDir": ".build/shared"
  },
  "include": ["packages/shared/types/**/*.ts"]
}